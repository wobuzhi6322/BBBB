{
  "routes": [
    {
      "src": "/assets/(site\\.css|web-tokens\\.css)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/@([^/]+)/d/([^/]+)",
      "dest": "/api/channel-page?handle=$1&messageId=$2"
    },
    {
      "src": "/@([^/]+)",
      "dest": "/api/channel-page?handle=$1"
    },
    {
      "src": "/me(/.*)?",
      "dest": "/me.html"
    },
    {
      "src": "/studio(/.*)?",
      "dest": "/studio.html"
    },
    {
      "src": "/channels/?",
      "dest": "/channels.html"
    },
    {
      "src": "/login/?",
      "dest": "/login.html"
    },
    {
      "src": "/signup/?",
      "dest": "/signup.html"
    }
  ],
  "functions": {
    "api/channel-page.ts": {
      "includeFiles": "public/channel.html"
    }
  }
}
